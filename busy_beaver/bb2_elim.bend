  match d:
    case TM.L{}:
      elim_b1.n(u, a0, a1, b0, w, TM.L{}, n, Lg.and_l(B.all_b1.n(u, a0, a1, b0, w, TM.L{}), B.all_b1.n(u, a0, a1, b0, w, TM.R{}), h))
    case TM.R{}:
      elim_b1.n(u, a0, a1, b0, w, TM.R{}, n, Lg.and_r(B.all_b1.n(u, a0, a1, b0, w, TM.L{}), B.all_b1.n(u, a0, a1, b0, w, TM.R{}), h))

