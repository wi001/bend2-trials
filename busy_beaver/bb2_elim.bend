def elim_b1(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2, +b0: TM.Rule2, r: TM.Rule2, h: {B.all_b1(u, a0, a1, b0) == True{} : Bool}) -> {B.check2(u, a0, a1, b0, r) == True{} : Bool}:
  match r:
    case TM.Stop2{}:
      Lg.and_l(B.check2(u, a0, a1, b0, TM.Stop2{}), B.all_b1.w(u, a0, a1, b0), h)
    case TM.Go2{w, d, n}:
      elim_b1.w(u, a0, a1, b0, w, d, n, Lg.and_r(B.check2(u, a0, a1, b0, TM.Stop2{}), B.all_b1.w(u, a0, a1, b0), h))

