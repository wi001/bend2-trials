# Generated by gen_bb2.py: from all_a0(u) == True to check2(u, a0, a1, b0, b1) == True
# for any four rules, by walking the enumeration's conjunctions back down.
import Base
import ./tm.bend as TM
import ./logic.bend as Lg
import ./bb2.bend as B

def elim_b1.n(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2, +b0: TM.Rule2, +w: Bool, +d: TM.Dir, n: Bool,
    h: {B.all_b1.n(u, a0, a1, b0, w, d) == True{} : Bool}) -> {B.check2(u, a0, a1, b0, TM.Go2{w, d, n}) == True{} : Bool}:
  match n:
    case False{}:
      Lg.and_l(B.check2(u, a0, a1, b0, TM.Go2{w, d, False{}}), B.check2(u, a0, a1, b0, TM.Go2{w, d, True{}}), h)
    case True{}:
      Lg.and_r(B.check2(u, a0, a1, b0, TM.Go2{w, d, False{}}), B.check2(u, a0, a1, b0, TM.Go2{w, d, True{}}), h)

