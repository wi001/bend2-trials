# BB(2): every two-state machine either halts by step 6 or is proven by the
# decider never to halt. all_a0(1n) checks all 9^4 = 6,561 of them.
# The enumeration below is generated by gen_bb2.py.
import Base
import ./tm.bend as TM
import ./abs.bend as A

# halts by step 6, or decided with one exact cell per side and 100 search steps.
# The gate u keeps every check unevaluated until u is a number: the proven
# kernel would otherwise evaluate the closed checks inside the elimination
# lemmas' types and run out of fuel. all_a0(1n) runs them all once.
def check2(u: Nat, a0: TM.Rule2, a1: TM.Rule2, b0: TM.Rule2, b1: TM.Rule2) -> Bool:
  match u:
    case 0n:
      False{}
    case 1n+v:
      A.check(TM.machine2(a0, a1, b0, b1), 6n, 1n, 100n)

def all_b1.n(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2, +b0: TM.Rule2, +w: Bool, +d: TM.Dir) -> Bool:
  Bool.and(check2(u, a0, a1, b0, TM.Go2{w, d, False{}}), check2(u, a0, a1, b0, TM.Go2{w, d, True{}}))

def all_b1.d(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2, +b0: TM.Rule2, +w: Bool) -> Bool:
  Bool.and(all_b1.n(u, a0, a1, b0, w, TM.L{}), all_b1.n(u, a0, a1, b0, w, TM.R{}))

def all_b1.w(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2, +b0: TM.Rule2) -> Bool:
  Bool.and(all_b1.d(u, a0, a1, b0, False{}), all_b1.d(u, a0, a1, b0, True{}))

def all_b1(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2, +b0: TM.Rule2) -> Bool:
  Bool.and(check2(u, a0, a1, b0, TM.Stop2{}), all_b1.w(u, a0, a1, b0))

def all_b0.n(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2, +w: Bool, +d: TM.Dir) -> Bool:
  Bool.and(all_b1(u, a0, a1, TM.Go2{w, d, False{}}), all_b1(u, a0, a1, TM.Go2{w, d, True{}}))

def all_b0.d(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2, +w: Bool) -> Bool:
  Bool.and(all_b0.n(u, a0, a1, w, TM.L{}), all_b0.n(u, a0, a1, w, TM.R{}))

def all_b0.w(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2) -> Bool:
  Bool.and(all_b0.d(u, a0, a1, False{}), all_b0.d(u, a0, a1, True{}))

def all_b0(+u: Nat, +a0: TM.Rule2, +a1: TM.Rule2) -> Bool:
  Bool.and(all_b1(u, a0, a1, TM.Stop2{}), all_b0.w(u, a0, a1))

def all_a1.n(+u: Nat, +a0: TM.Rule2, +w: Bool, +d: TM.Dir) -> Bool:
  Bool.and(all_b0(u, a0, TM.Go2{w, d, False{}}), all_b0(u, a0, TM.Go2{w, d, True{}}))

def all_a1.d(+u: Nat, +a0: TM.Rule2, +w: Bool) -> Bool:
  Bool.and(all_a1.n(u, a0, w, TM.L{}), all_a1.n(u, a0, w, TM.R{}))

def all_a1.w(+u: Nat, +a0: TM.Rule2) -> Bool:
  Bool.and(all_a1.d(u, a0, False{}), all_a1.d(u, a0, True{}))

def all_a1(+u: Nat, +a0: TM.Rule2) -> Bool:
  Bool.and(all_b0(u, a0, TM.Stop2{}), all_a1.w(u, a0))

def all_a0.n(+u: Nat, +w: Bool, +d: TM.Dir) -> Bool:
  Bool.and(all_a1(u, TM.Go2{w, d, False{}}), all_a1(u, TM.Go2{w, d, True{}}))

def all_a0.d(+u: Nat, +w: Bool) -> Bool:
  Bool.and(all_a0.n(u, w, TM.L{}), all_a0.n(u, w, TM.R{}))

def all_a0.w(+u: Nat) -> Bool:
  Bool.and(all_a0.d(u, False{}), all_a0.d(u, True{}))

def all_a0(+u: Nat) -> Bool:
  Bool.and(all_a1(u, TM.Stop2{}), all_a0.w(u))
